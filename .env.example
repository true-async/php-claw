# Copy to .env and fill in. .env is git-ignored; real environment variables
# take precedence over values in this file.

# Channel: console (type in the terminal) | telegram (not wired yet).
CLAW_CHANNEL=console

# Agent backend: claude | openai-compatible | gemini
CLAW_AGENT=openai-compatible

# API key for the chosen provider (only the matching one is needed).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Base URL for openai-compatible providers
# (DeepSeek / Groq / Mistral / Qwen / Ollama / OpenRouter / OpenAI).
CLAW_BASE_URL=https://api.openai.com/v1

# Model id (must support tool calling).
CLAW_MODEL=gpt-4o-mini

# Sandbox working directory for file/bash tools.
CLAW_WORKSPACE=./workspace

# Memory control: soft cap on history messages. 0 = unbounded
# (the model's context window is the only limit).
CLAW_MAX_HISTORY=0

# Per-task timeout in ms (reserved; not enforced yet).
CLAW_TURN_TIMEOUT_MS=300000

# --- Telegram channel only (required when CLAW_CHANNEL=telegram) ---
# TELEGRAM_BOT_TOKEN=
# CLAW_ALLOWED_CHATS=          # comma-separated chat ids allowed to use the bot
