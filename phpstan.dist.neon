parameters:
    level: 8
    paths:
        - src
        - bin/claw
        - tests
    # Official TrueAsync stubs (dev-only). Scan just the Async namespace —
    # the package's root src/ also redeclares the global \PDO, which would
    # clash with PHPStan's built-in PDO knowledge.
    scanDirectories:
        - vendor/true-async/ide-helper/src/Async
    # Async\Cancellation (the Throwable root that AsyncCancellation extends) lives
    # in the package root, not under src/Async. Pull in just that file so PHPStan
    # knows the class is catchable, without scanning all of src/ (it redeclares \PDO).
    scanFiles:
        - vendor/true-async/ide-helper/src/Cancellation.php
        # HTTP server extension classes (HttpServer, HttpRequest, HttpResponse, …)
        # used by src/Server.php. A single file, so it sidesteps the root \PDO clash.
        - vendor/true-async/ide-helper/src/Server/true-async-server.php
